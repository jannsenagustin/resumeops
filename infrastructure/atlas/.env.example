# Copy this file to .env. Never commit the local .env file.

# Compose identity
ATLAS_PROJECT_NAME=atlas

# Official image repository. Verify and select a supported tag before deployment.
SPLUNK_IMAGE=splunk/splunk
SPLUNK_VERSION=VERIFY_SUPPORTED_TAG

# Replace with a strong local value that meets Splunk password requirements.
SPLUNK_PASSWORD=CHANGE_ME

# Read and accept the applicable Splunk license and general terms before replacing
# these blocking placeholders with the arguments required by the selected version.
SPLUNK_START_ARGS=REVIEW_LICENSE_BEFORE_USE
SPLUNK_GENERAL_TERMS=REVIEW_GENERAL_TERMS_BEFORE_USE

# Proposed localhost-only Web mappings. Adjust if a host port is already in use.
ATLAS_SEARCH_HEAD_WEB_PORT=8000
ATLAS_INDEXER_WEB_PORT=8001
ATLAS_DEPLOYMENT_SERVER_WEB_PORT=8002

# Internal-only management endpoints use container port 8089.
# These proposed values are reserved only if later troubleshooting requires
# temporary localhost publication; docker-compose.yml does not publish them.
ATLAS_SEARCH_HEAD_MANAGEMENT_PORT=8089
ATLAS_INDEXER_MANAGEMENT_PORT=8090
ATLAS_DEPLOYMENT_SERVER_MANAGEMENT_PORT=8091

# Internal future receiver port. Sprint 6C must enable receiving before use.
ATLAS_INDEXER_RECEIVER_PORT=9997
