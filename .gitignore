# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-v2/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!infrastructure/atlas/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Atlas evidence containing secret-bearing Splunk configuration
/docs/evidence/milestone-03-distributed-search/2026-08-06_001_server.conf_configuration.png
/.evidence-private/

# Local Hyper-V runtime and installer content; allow safe source documentation.
/infrastructure/hyper-v/checkpoints/**
/infrastructure/hyper-v/downloads/**
/infrastructure/hyper-v/iso/**
/infrastructure/hyper-v/virtual-hard-disks/**
/infrastructure/hyper-v/virtual-machines/**
