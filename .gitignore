!/infrastructure/hyper-v/**/*.md
!/infrastructure/hyper-v/**/*.ps1
!/infrastructure/hyper-v/**/*.json
!/infrastructure/hyper-v/**/*.yml
!/infrastructure/hyper-v/**/*.yaml
